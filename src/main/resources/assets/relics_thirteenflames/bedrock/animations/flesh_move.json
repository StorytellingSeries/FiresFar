				},
				"Body": {
					"rotation": [0, 0, "math.sin(query.anim_time*360)*2"],
					"position": [0, 0, "1-math.cos(query.anim_time*360)/2"],
					"scale": [1, 1, "1-math.cos(query.anim_time*360)/16"]
				}
			}
		}
	}
}